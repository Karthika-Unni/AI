import math

game_tree = [3, 5, 6, 9, 1, 2, 0, -1]

def alphabeta(depth, index, isMax, alpha, beta):

    if depth == 3:
        return game_tree[index]

    if isMax:
        best = -math.inf
        for i in range(2):
            value = alphabeta(depth + 1, index * 2 + i, False, alpha, beta)
            best = max(best, value)
            alpha = max(alpha, best)

            if alpha >= beta:
                break
        return best

    else:
        best = math.inf
        for i in range(2):
            value = alphabeta(depth + 1, index * 2 + i, True, alpha, beta)
            best = min(best, value)
            beta = min(beta, best)

            if alpha >= beta:
                break
        return best

result = alphabeta(0, 0, True, -math.inf, math.inf)

print("Best Value:", result)
