def print_grid(grid):
    """Display the Sudoku grid."""
    for row in grid:
        print(" ".join(map(str, row)))
def is_safe(grid, row, col, num):
    """Check whether num can be placed at grid[row][col]."""
    for j in range(9):
        if grid[row][j] == num:
            return False
    for i in range(9):
        if grid[i][col] == num:
            return False
    start_row = row - row % 3
    start_col = col - col % 3
    for i in range(3):
        for j in range(3):
            if grid[start_row + i][start_col + j] == num:
                return False
    return True
def find_empty_cell(grid):
    """Find an empty cell represented by 0."""
    for i in range(9):
        for j in range(9):
            if grid[i][j] == 0:
                return i, j
    return None
def solve_sudoku(grid):
    """Solve Sudoku using recursive backtracking."""
    empty_cell = find_empty_cell(grid)
    if empty_cell is None:
        return True
    row, col = empty_cell
    for num in range(1, 10):
        if is_safe(grid, row, col, num):
            grid[row][col] = num
            if solve_sudoku(grid):
                return True
            grid[row][col] = 0
    return False
grid = [
    [5, 3, 0, 0, 7, 0, 0, 0, 0],
    [6, 0, 0, 1, 9, 5, 0, 0, 0],
    [0, 9, 8, 0, 0, 0, 0, 6, 0], 

    [8, 0, 0, 0, 6, 0, 0, 0, 3],
    [4, 0, 0, 8, 0, 3, 0, 0, 1],
    [7, 0, 0, 0, 2, 0, 0, 0, 6],

    [0, 6, 0, 0, 0, 0, 2, 8, 0],
    [0, 0, 0, 4, 1, 9, 0, 0, 5],
    [0, 0, 0, 0, 8, 0, 0, 7, 9]
]
print("Original Sudoku:")
print_grid(grid)
if solve_sudoku(grid):
    print("\nSolved Sudoku:")
    print_grid(grid)
else:
    print("\nNo solution exists.")
